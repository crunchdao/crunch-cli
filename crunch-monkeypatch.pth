import os, sys; exec('try: import crunch.monkey_patches; crunch.monkey_patches.apply_all()\nexcept ImportError as error: print("crunch: could not auto monkey patch:", error, file=sys.stderr)') if os.environ.get("CRUNCH_AUTO_MONKEY_PATCH", "false").lower() == "true" else exec('try: import crunch.monkey_patches; crunch.monkey_patches.apply_for_user_code_child_process()\nexcept ImportError as error: print("crunch: could not patch for the user code:", error, file=sys.stderr)') if os.environ.get("CRUNCH_USER_CODE_MODULE_NAME") else None
